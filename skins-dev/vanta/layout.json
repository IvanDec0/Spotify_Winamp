{
  "schemaVersion": 1,
  "root": {
    "type": "stack",
    "name": "stage",
    "children": [
      {
        "type": "column",
        "name": "shell",
        "children": [
          {
            "type": "component",
            "component": "titlebar",
            "name": "canopy",
            "props": {
              "showBrand": true,
              "showProvider": true,
              "showDevice": false,
              "showWindowControls": true,
              "compact": true
            }
          },
          {
            "type": "row",
            "name": "cockpit",
            "props": {
              "gap": 0,
              "padding": 0,
              "align": "stretch"
            },
            "children": [
              {
                "type": "column",
                "name": "core",
                "props": {
                  "gap": 0,
                  "padding": 0,
                  "align": "center",
                  "justify": "start"
                },
                "children": [
                  {
                    "type": "stack",
                    "name": "core-stage",
                    "props": {
                      "padding": 0,
                      "align": "center"
                    },
                    "children": [
                      {
                        "type": "column",
                        "name": "reactor",
                        "props": {
                          "gap": 0,
                          "padding": 0,
                          "align": "center",
                          "justify": "center"
                        },
                        "children": [
                          {
                            "type": "component",
                            "component": "album-art",
                            "props": {
                              "size": 128,
                              "frame": true,
                              "reflection": false
                            }
                          }
                        ]
                      }
                    ]
                  },
                  {
                    "type": "row",
                    "name": "control-pod",
                    "props": {
                      "gap": 0,
                      "padding": 0,
                      "align": "center",
                      "justify": "center"
                    },
                    "children": [
                      {
                        "type": "component",
                        "component": "transport-controls",
                        "props": {
                          "size": "large",
                          "showShuffle": false,
                          "showRepeat": false
                        }
                      }
                    ]
                  }
                ]
              },
              {
                "type": "column",
                "name": "readout",
                "props": {
                  "gap": 0,
                  "padding": 0,
                  "align": "stretch",
                  "justify": "space-between"
                },
                "children": [
                  {
                    "type": "column",
                    "name": "display",
                    "props": {
                      "gap": 4,
                      "padding": 0,
                      "align": "stretch",
                      "justify": "start"
                    },
                    "children": [
                      {
                        "type": "component",
                        "component": "track-info",
                        "props": {
                          "showAlbum": true,
                          "showStatus": true,
                          "align": "left"
                        }
                      },
                      {
                        "type": "component",
                        "component": "progress",
                        "props": {
                          "showTime": true,
                          "showRemaining": false
                        }
                      },
                      {
                        "type": "component",
                        "component": "visualizer",
                        "props": {
                          "mode": "grid",
                          "layer": "inline",
                          "intensity": 0.5
                        }
                      }
                    ]
                  },
                  {
                    "type": "row",
                    "name": "utilities",
                    "props": {
                      "gap": 0,
                      "padding": 0,
                      "align": "center",
                      "justify": "space-between"
                    },
                    "children": [
                      {
                        "type": "component",
                        "component": "shuffle"
                      },
                      {
                        "type": "component",
                        "component": "repeat"
                      },
                      {
                        "type": "component",
                        "component": "volume",
                        "props": {
                          "orientation": "horizontal",
                          "showIcon": true
                        }
                      },
                      {
                        "type": "component",
                        "component": "device-picker",
                        "props": {
                          "compact": false
                        }
                      }
                    ]
                  }
                ]
              }
            ]
          },
          {
            "type": "component",
            "component": "queue",
            "props": {
              "maxItems": 10,
              "showHeader": true,
              "showArt": true,
              "showTime": true
            }
          }
        ]
      }
    ]
  }
}
