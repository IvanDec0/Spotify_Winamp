{
  "schemaVersion": 1,
  "id": "vanta",
  "name": "Vanta",
  "version": "2.0.0",
  "description": "An asymmetric cockpit player with a reactor core, blade transport pod, angular telemetry display and theme-specific geometry. Original CSS artwork.",
  "author": "Cadence",
  "license": "CC BY-SA 4.0",
  "entry": {
    "layout": "layout.json",
    "styles": "styles.css"
  },
  "capabilities": [
    "player.read",
    "player.control",
    "queue.read",
    "devices.read",
    "devices.control"
  ],
  "themes": ["darkstar", "bionic", "reactor"],
  "defaultTheme": "darkstar",
  "visualizer": {
    "modes": ["radial", "spectrum", "oscilloscope", "grid"],
    "default": "radial",
    "intensity": 0.8
  },
  "window": {
    "width": 420,
    "height": 220,
    "minWidth": 380,
    "minHeight": 200,
    "queueHeight": 460,
    "resizable": true
  }
}
