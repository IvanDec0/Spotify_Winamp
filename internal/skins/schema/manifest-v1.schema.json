{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cadence.local/schemas/manifest-v1.json",
  "title": "Cadence skin manifest v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "id",
    "name",
    "version",
    "description",
    "author",
    "license",
    "entry",
    "capabilities",
    "themes",
    "defaultTheme",
    "visualizer",
    "window"
  ],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9]([a-z0-9-]{0,62}[a-z0-9])?$"
    },
    "name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 80
    },
    "version": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+([-+][0-9A-Za-z.-]+)?$"
    },
    "description": {
      "type": "string",
      "maxLength": 400
    },
    "author": {
      "type": "string",
      "minLength": 1,
      "maxLength": 100
    },
    "license": {
      "type": "string",
      "minLength": 1,
      "maxLength": 100
    },
    "entry": {
      "type": "object",
      "additionalProperties": false,
      "required": ["layout", "styles"],
      "properties": {
        "layout": {
          "const": "layout.json"
        },
        "styles": {
          "const": "styles.css"
        }
      }
    },
    "capabilities": {
      "type": "array",
      "minItems": 1,
      "maxItems": 5,
      "uniqueItems": true,
      "items": {
        "enum": [
          "player.read",
          "player.control",
          "queue.read",
          "devices.read",
          "devices.control"
        ]
      }
    },
    "themes": {
      "type": "array",
      "minItems": 1,
      "maxItems": 12,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^[a-z0-9]([a-z0-9-]{0,30}[a-z0-9])?$"
      }
    },
    "defaultTheme": {
      "type": "string",
      "pattern": "^[a-z0-9]([a-z0-9-]{0,30}[a-z0-9])?$"
    },
    "visualizer": {
      "type": "object",
      "additionalProperties": false,
      "required": ["modes", "default", "intensity"],
      "properties": {
        "modes": {
          "type": "array",
          "minItems": 1,
          "maxItems": 4,
          "uniqueItems": true,
          "items": {
            "enum": ["spectrum", "radial", "oscilloscope", "grid"]
          }
        },
        "default": {
          "enum": ["spectrum", "radial", "oscilloscope", "grid"]
        },
        "intensity": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        }
      }
    },
    "window": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "width",
        "height",
        "minWidth",
        "minHeight",
        "queueHeight",
        "resizable"
      ],
      "properties": {
        "width": {
          "const": 420
        },
        "height": {
          "const": 220
        },
        "minWidth": {
          "const": 380
        },
        "minHeight": {
          "const": 200
        },
        "queueHeight": {
          "const": 460
        },
        "resizable": {
          "type": "boolean"
        }
      }
    }
  }
}
