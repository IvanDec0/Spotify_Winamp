new file mode 100644
index 0000000..327e53e
--- /dev/null
+++ b/daemon/search.go
@@ -0,0 +1,47 @@
+package daemon
+
+import (
+	"net/http"
+	"strconv"
+	"strings"
+)
+
+type ApiSearchRequest struct {
+	Query string
+	Limit int
+}
+
+type ApiRadioRequest struct {
+	Uri string `json:"uri"`
+}
+
+// HandleSearch accepts GET /search?q=...&limit=... and returns tracks, albums,
+// artists and playlists from Spotify's internal search.
+func (s *ConcreteApiServer) HandleSearch(w http.ResponseWriter, r *http.Request) {
+	query := strings.TrimSpace(r.URL.Query().Get("q"))
+	if query == "" {
+		w.WriteHeader(http.StatusBadRequest)
+		return
+	}
+	limit := 20
+	if raw := r.URL.Query().Get("limit"); raw != "" {
+		if value, err := strconv.Atoi(raw); err == nil && value > 0 {
+			limit = value
+		}
+	}
+	s.handleRequest(ApiRequest{
+		Type: ApiRequestTypeSearch,
+		Data: ApiSearchRequest{Query: query, Limit: limit},
+	}, w)
+}
+
+// HandlePlayerRadio accepts POST /player/radio with a seed URI and starts a
+// Spotify radio station derived from it.
+func (s *ConcreteApiServer) HandlePlayerRadio(w http.ResponseWriter, r *http.Request) {
+	var data ApiRadioRequest
+	if err := jsonDecode(r, &data); err != nil || strings.TrimSpace(data.Uri) == "" {
+		w.WriteHeader(http.StatusBadRequest)
+		return
+	}
+	s.handleRequest(ApiRequest{Type: ApiRequestTypeRadio, Data: data}, w)
+}
