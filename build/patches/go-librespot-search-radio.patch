diff --git a/spclient/searchview.go b/spclient/searchview.go
new file mode 100644
index 0000000..8952a15
--- /dev/null
+++ b/spclient/searchview.go
@@ -0,0 +1,116 @@
+package spclient
+
+import (
+	"context"
+	"crypto/rand"
+	"encoding/json"
+	"fmt"
+	"io"
+	"net/url"
+	"strconv"
+	"strings"
+	"time"
+)
+
+type SearchArtist struct {
+	Name string `json:"name"`
+	URI  string `json:"uri"`
+}
+
+type SearchAlbum struct {
+	Name string `json:"name"`
+	URI  string `json:"uri"`
+}
+
+type SearchHit struct {
+	Name           string         `json:"name"`
+	URI            string         `json:"uri"`
+	Image          string         `json:"image"`
+	Artists        []SearchArtist `json:"artists"`
+	Album          *SearchAlbum   `json:"album,omitempty"`
+	Duration       int            `json:"duration"`
+	Author         string         `json:"author"`
+	FollowersCount int            `json:"followersCount"`
+	Verified       bool           `json:"verified"`
+}
+
+type SearchGroup struct {
+	Hits  []SearchHit `json:"hits"`
+	Total int         `json:"total"`
+}
+
+type SearchResults struct {
+	Tracks    SearchGroup `json:"tracks"`
+	Albums    SearchGroup `json:"albums"`
+	Artists   SearchGroup `json:"artists"`
+	Playlists SearchGroup `json:"playlists"`
+}
+
+type searchResponse struct {
+	Results SearchResults `json:"results"`
+}
+
+func searchUUID() string {
+	var b [16]byte
+	_, _ = rand.Read(b[:])
+	b[6] = (b[6] & 0x0f) | 0x40
+	b[8] = (b[8] & 0x3f) | 0x80
+	return fmt.Sprintf("%x-%x-%x-%x-%x", b[0:4], b[4:6], b[6:8], b[8:10], b[10:16])
+}
+
+// Search queries Spotify's internal search view, which, unlike the public Web
+// API, is available from the session's own access token.
+func (c *Spclient) Search(ctx context.Context, query, username, country, locale string, limit int) (*SearchResults, error) {
+	query = strings.TrimSpace(query)
+	if query == "" {
+		return nil, fmt.Errorf("empty search query")
+	}
+	if country == "" {
+		country = "US"
+	}
+	if locale == "" {
+		locale = "en_US"
+	}
+	if limit < 1 {
+		limit = 20
+	} else if limit > 50 {
+		limit = 50
+	}
+
+	params := url.Values{}
+	params.Set("username", username)
+	params.Set("country", country)
+	params.Set("catalogue", "premium")
+	params.Set("locale", locale)
+	params.Set("limit", strconv.Itoa(limit))
+	params.Set("search-image-size", "240")
+	params.Set("search-image-size-cards", "720")
+	params.Set("echo", "onDemand")
+	params.Set("radio", "false")
+	params.Set("mft", "false")
+	params.Set("searchIntentID", searchUUID())
+	params.Set("sequenceNumber", "2")
+	params.Set("entityVersion", "6")
+	params.Set("clientVersion", "8.9.0")
+	params.Set("timestamp", strconv.FormatInt(time.Now().UnixMilli(), 10))
+
+	path := url.PathEscape(strings.ReplaceAll(query, " ", "+"))
+	hm := "hm://searchview/km/v4/search/" + path + "?" + params.Encode()
+	resp, err := c.RequestHm(ctx, "GET", hm, nil, nil)
+	if err != nil {
+		return nil, err
+	}
+	defer resp.Body.Close()
+	if resp.StatusCode != 200 {
+		return nil, fmt.Errorf("search returned status %d", resp.StatusCode)
+	}
+	body, err := io.ReadAll(io.LimitReader(resp.Body, 8<<20))
+	if err != nil {
+		return nil, err
+	}
+	var result searchResponse
+	if err := json.Unmarshal(body, &result); err != nil {
+		return nil, fmt.Errorf("invalid search response: %w", err)
+	}
+	return &result.Results, nil
+}
