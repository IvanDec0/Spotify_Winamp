diff -ruN a/daemon/library_collection.go b/daemon/library_collection.go
--- a/daemon/library_collection.go	1969-12-31 21:00:00.000000000 -0300
+++ b/daemon/library_collection.go	2026-11-05 08:46:59.123977853 -0300
@@ -0,0 +1,81 @@
+package daemon
+
+import (
+	"net/http"
+
+	librespot "github.com/devgianlu/go-librespot"
+	"github.com/devgianlu/go-librespot/spclient"
+)
+
+// collectionSetShows is the collection set holding saved shows.
+const collectionSetShows = "show"
+
+// ApiCollectionWrite carries a generic collection write: the set to change,
+// the URIs and whether to remove them.
+type ApiCollectionWrite struct {
+	Set    string   `json:"set"`
+	Uris   []string `json:"uris"`
+	Remove bool     `json:"remove"`
+}
+
+// ApiCollectionContains carries the set and URIs of a contains request.
+type ApiCollectionContains struct {
+	Set  string   `json:"set"`
+	Uris []string `json:"uris"`
+}
+
+// ApiCollectionContainsResult answers one boolean per requested URI, in
+// request order.
+type ApiCollectionContainsResult struct {
+	Contains []bool `json:"contains"`
+}
+
+// validCollectionSet reports whether set is one of the sets the generic
+// library routes may write or read.
+func validCollectionSet(set string) bool {
+	switch set {
+	case spclient.CollectionSetLikedSongs, spclient.CollectionSetArtists, collectionSetShows:
+		return true
+	default:
+		return false
+	}
+}
+
+// validCollectionUris reports whether uris holds 1 to maxLibraryUris Spotify
+// URIs of any type, so albums, artists and shows can use the same routes as
+// tracks.
+func validCollectionUris(uris []string) bool {
+	if len(uris) == 0 || len(uris) > maxLibraryUris {
+		return false
+	}
+	for _, uri := range uris {
+		if _, err := librespot.SpotifyIdFromUri(uri); err != nil {
+			return false
+		}
+	}
+	return true
+}
+
+// HandleCollectionWrite accepts POST /library/collection/write and changes one
+// user collection set.
+func (s *ConcreteApiServer) HandleCollectionWrite(w http.ResponseWriter, r *http.Request) {
+	var data ApiCollectionWrite
+	if err := jsonDecode(r, &data); err != nil || !validCollectionSet(data.Set) || !validCollectionUris(data.Uris) {
+		w.WriteHeader(http.StatusBadRequest)
+		return
+	}
+
+	s.handleRequest(ApiRequest{Type: ApiRequestTypeCollectionWrite, Data: data}, w)
+}
+
+// HandleCollectionContains accepts POST /library/collection/contains and
+// answers whether each URI is in one collection set.
+func (s *ConcreteApiServer) HandleCollectionContains(w http.ResponseWriter, r *http.Request) {
+	var data ApiCollectionContains
+	if err := jsonDecode(r, &data); err != nil || !validCollectionSet(data.Set) || !validCollectionUris(data.Uris) {
+		w.WriteHeader(http.StatusBadRequest)
+		return
+	}
+
+	s.handleRequest(ApiRequest{Type: ApiRequestTypeCollectionContains, Data: data}, w)
+}
